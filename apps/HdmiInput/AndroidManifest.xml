    Entrada HDMI do HY300 no framework de TV input: o serviço de TV input de hardware e a tela
    cheia com o TvView. Só no LineageOS (APIs de sistema).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.hy300.hdmi">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <uses-permission android:name="android.permission.TV_INPUT_HARDWARE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_ROUTING" />
    <uses-permission android:name="com.android.providers.tv.permission.READ_EPG_DATA" />

    <application
        android:label="@string/app_name"
        android:banner="@drawable/banner"
        android:icon="@drawable/banner"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">

        <service
            android:name=".HdmiInputService"
            android:exported="true"
            android:permission="android.permission.BIND_TV_INPUT">
            <intent-filter>
                <action android:name="android.media.tv.TvInputService" />
            </intent-filter>
            <meta-data
                android:name="android.media.tv.input"
                android:resource="@xml/hdmi_input" />
        </service>

        <activity
            android:name=".HdmiActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:scheme="content"
                    android:host="android.media.tv"
                    android:pathPrefix="/passthrough" />
            </intent-filter>
        </activity>
    </application>
</manifest>
