#
# Bluetooth do AIC8800 (UART1): o hy300-bt-uart liga o rfkill e ajusta a UART antes do HAL
# AIDL padrão (android.hardware.bluetooth-service.default). O modo vem de ro.vendor.hy300.bt.mode.
# Roda como root porque o rfkill do Bluetooth pode não ser o rfkill0 (o init.rk3566.rc só dá o
# rfkill0 ao usuário bluetooth); a sepolicy (hy300_bt_uart) limita ao tty e ao rfkill.
service vendor.hy300-bt-uart /vendor/bin/hy300-bt-uart
    class hal
    user root
    group bluetooth
    oneshot

# Segunda passada depois dos módulos do AIC8800 (hy300-wifi-modules grava a prop no fim): o
# aic8800_btlpm cria o rfkill "bluetooth" só nessa hora, depois da primeira passada (boot 7).
on property:vendor.hy300.wifi.iface=*
    start vendor.hy300-bt-uart
