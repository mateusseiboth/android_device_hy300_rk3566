# fstab do HY300 para o LineageOS. Derivado do /vendor/etc/fstab.rk30board de fábrica.
#
# Mudanças em relação à fábrica (motivo em README.md):
#  - sem vendor_dlkm/odm_dlkm: os módulos vão no vendor;
#  - /data com FBE v2 (a fábrica usa "fileencryption=software", v1). O /data é
#    formatado na troca de sistema de qualquer jeito;
#  - sem zram: quem monta o zram e o writeback para o eMMC é o mmd (device.mk);
#  - sem as linhas de SATA e de NAND, que a placa não tem;
#  - /cust (partição da TXCZ) não é montada; a partição fica intocada.
#
#<src>                         <mnt_point>  <type> <mnt_flags and options>                                     <fs_mgr_flags>
system                         /system      ext4   ro,barrier=1                                                wait,logical,first_stage_mount
system_ext                     /system_ext  ext4   ro,barrier=1                                                wait,logical,first_stage_mount
product                        /product     ext4   ro,barrier=1                                                wait,logical,first_stage_mount
vendor                         /vendor      ext4   ro,barrier=1                                                wait,logical,first_stage_mount
odm                            /odm         ext4   ro,barrier=1                                                wait,logical,first_stage_mount

/dev/block/by-name/boot        /boot        emmc   defaults                                                    defaults
/dev/block/by-name/recovery    /recovery    emmc   defaults                                                    defaults
/dev/block/by-name/misc        /misc        emmc   defaults                                                    defaults
/dev/block/by-name/metadata    /metadata    ext4   nodev,noatime,nosuid,discard,sync                           wait,formattable,first_stage_mount,check
/dev/block/by-name/cache       /cache       ext4   noatime,nosuid,nodev,noauto_da_alloc,discard                wait,check,formattable

# Com o kernel Rockchip Android (ACK), que tem dm-default-key, trocar o fileencryption
# abaixo por: fileencryption=aes-256-xts:aes-256-cts:v2,metadata_encryption=aes-256-xts,keydirectory=/metadata/vold/metadata_encryption
/dev/block/by-name/userdata    /data        ext4   discard,noatime,nosuid,nodev,noauto_da_alloc,data=ordered,user_xattr,barrier=1  latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2,quota,reservedsize=128M,checkpoint=block

# USB-A (dwc3 em modo host, fcc00000) e o slot do cartão da fábrica
/devices/platform/*usb*                            auto  vfat  defaults  voldmanaged=usb:auto
/devices/platform/fe2b0000.mmc/mmc_host*           auto  auto  defaults  voldmanaged=sdcard1:auto
