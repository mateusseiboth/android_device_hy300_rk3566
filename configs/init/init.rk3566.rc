# init do HY300 (importado pelo init.rc como /vendor/etc/init/hw/init.${ro.hardware}.rc,
# ro.hardware=rk3566 vem da cmdline). Só o que a placa precisa; o que a fábrica fazia para
# outras placas Rockchip (HDMI, OTG, fb, Mali kbase, PQ) ficou de fora.

on early-init
    # zram com lz4 e swap agressivo, como na fábrica (1,5 GB de RAM)
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/swappiness 100

    # GPU Mali-G52: o Panfrost é módulo no kernel Android (hy300-ack-6.1). Tem que estar
    # carregado antes do allocator, do composer e do SurfaceFlinger (classe core/hal).
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules drm_shmem_helper gpu-sched panfrost

on fs
    mount_all /vendor/etc/fstab.rk3566 --early

on late-fs
    mount_all /vendor/etc/fstab.rk3566 --late

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # Desempenho primeiro (vídeo em streaming engasgava na fábrica). CPU no governador
    # performance: com o driver de cpufreq e a tabela OPP do DT ela fica no máximo nominal
    # (1,8 GHz); sem o driver (kernel atual), as escritas falham sem efeito. A proteção térmica
    # é do kernel (thermal zones do DT) e limita a frequência por cima do governador.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance

    # GPU (devfreq do Panfrost) e DDR (dmc) no máximo.
    write /sys/class/devfreq/fde60000.gpu/governor performance
    write /sys/class/devfreq/dmc/governor performance

    # Motor de foco e LEDs indicadores, que o app io.github.hy300.settings (priv-app, uid de app,
    # não system) usa. Mesmas permissões da fábrica (motor 0777, LEDs 0666 pelo hy300-settings.rc).
    # Ventoinha (Fan_h) e fonte de luz (Lcd_power) ficam só para root: desligar a ventoinha com a
    # luz acesa aquece o projetor.
    chmod 0666 /sys/class/motor_cc/motor_cc/motor
    chmod 0444 /sys/class/motor_cc/motor_cc/hd_camera_on
    chmod 0666 /sys/class/leds/green/brightness
    chmod 0666 /sys/class/leds/red/brightness

    # Bluetooth AIC8800 (UART1 = ttyS1; a permissão do nó está no ueventd)
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state

    # Keystone: o compositor relê os cantos persist.sys.keystone.* no boot, como o
    # init.rk356x.rc de fábrica fazia.
    setprop persist.sys.keystone.update 1

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.rk3566

# Alpine na partição boot, LineageOS na recovery: um "reboot recovery" ou o "redefinir para a
# fábrica" gravam boot-recovery no BCB da misc, o U-Boot passa a subir sempre a recovery e o
# Alpine fica inalcançável. O script apaga só esse comando (2048 bytes do bootloader_message), no
# começo e no fim do boot. Mesma lógica do android/clear-bcb do hy300-alpine.
service hy300-clear-bcb /vendor/bin/sh /vendor/bin/hy300-clear-bcb.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on post-fs-data
    start hy300-clear-bcb

on property:sys.boot_completed=1
    start hy300-clear-bcb

# Watchdog (dw_wdt com pré-timeout em panic; o kernel o alimenta até alguém abrir /dev/watchdog).
# O watchdogd do AOSP passa a alimentar a cada 10 s com timeout de 30 s: se o userspace parar e
# ele não rodar mais, o pré-timeout dá panic e o aparelho reinicia (panic=5), como no Alpine.
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    group root
    oom_score_adjust -1000
    seclabel u:r:watchdogd:s0
