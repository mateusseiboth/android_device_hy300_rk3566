# init do HY300 (importado pelo init.rc como /vendor/etc/init/hw/init.${ro.hardware}.rc,
# ro.hardware=rk3566 vem da cmdline). Só o que a placa precisa; o que a fábrica fazia para
# outras placas Rockchip (HDMI, OTG, fb, Mali kbase, PQ) ficou de fora.

on early-init
    # Swap agressivo, como na fábrica (1,5 GB de RAM). O zram em si é do mmd (device.mk).
    write /proc/sys/vm/swappiness 100

# GPU: androidboot.hy300.gpu na cmdline escolhe o caminho (o Alpine troca com o hy300-kexec, sem
# regravar). Os ro.hardware.* não estão nos build.prop justamente para serem decididos aqui.
#  - panfrost: Mali-G52 pelo Panfrost (módulo do hy300-ack-6.1) e o Mesa. O módulo tem de estar
#    carregado antes do allocator, do composer e do SurfaceFlinger (classe core/hal).
#  - sw: sem panfrost.ko; GLES pelo ANGLE sobre o SwiftShader (Vulkan por software). Lento, mas um
#    boot de teste nunca morre pela GPU.
on early-init && property:ro.boot.hy300.gpu=panfrost
    exec u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -a -d /vendor/lib/modules drm_shmem_helper gpu-sched panfrost
    # Sem runtime PM na GPU: no primeiro boot o Panfrost travou com a thread de IRQ da MMU girando
    # enquanto a thread de jobs suspendia a GPU (__pm_runtime_suspend). O panfrost do 6.1 não
    # sincroniza nem desliga as IRQs antes de desligar a GPU (o upstream corrigiu depois, em
    # "drm/panfrost: Synchronize and disable interrupts before powering off"). GPU sempre ligada.
    write /sys/devices/platform/fde60000.gpu/power/control on
    setprop ro.hardware.egl mesa
    setprop drm.gpu.vendor_name panfrost

on early-init && property:ro.boot.hy300.gpu=sw
    setprop ro.hardware.egl angle
    setprop ro.hardware.vulkan pastel

on fs
    mount_all /vendor/etc/fstab.rk3566 --early

on late-fs
    mount_all /vendor/etc/fstab.rk3566 --late

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # Desempenho primeiro (vídeo em streaming engasgava na fábrica). CPU no governador
    # performance: com o driver de cpufreq e a tabela OPP do DT ela fica no máximo nominal
    # (1,8 GHz); sem o driver (kernel atual), as escritas falham sem efeito. A proteção térmica
    # é do kernel (thermal zones do DT) e limita a frequência por cima do governador.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance

    # GPU (devfreq do Panfrost) e DDR (dmc) no máximo.
    write /sys/class/devfreq/fde60000.gpu/governor performance
    write /sys/class/devfreq/dmc/governor performance

    # Motor de foco e LEDs indicadores, que o app io.github.hy300.settings (priv-app, uid de app,
    # não system) usa. Mesmas permissões da fábrica (motor 0777, LEDs 0666 pelo hy300-settings.rc).
    # Ventoinha (Fan_h) e fonte de luz (Lcd_power) ficam só para root: desligar a ventoinha com a
    # luz acesa aquece o projetor.
    chmod 0666 /sys/class/motor_cc/motor_cc/motor
    chmod 0444 /sys/class/motor_cc/motor_cc/hd_camera_on
    chmod 0666 /sys/class/leds/green/brightness
    chmod 0666 /sys/class/leds/red/brightness

    # Bluetooth AIC8800 (UART1 = ttyS1; a permissão do nó está no ueventd)
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state

    # Keystone: o gatilho de releitura dos cantos fica no hy300-keystone.rc (system_ext), porque
    # persist.sys.* é do sistema e o vendor_init não pode gravar com SELinux enforcing.

# Alpine na partição boot, LineageOS na recovery: um "reboot recovery" ou o "redefinir para a
# fábrica" gravam boot-recovery no BCB da misc, o U-Boot passa a subir sempre a recovery e o
# Alpine fica inalcançável. O script apaga só esse comando (2048 bytes do bootloader_message), no
# começo e no fim do boot. Mesma lógica do android/clear-bcb do hy300-alpine.
service hy300-clear-bcb /vendor/bin/sh /vendor/bin/hy300-clear-bcb.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on post-fs-data
    start hy300-clear-bcb

on property:sys.boot_completed=1
    start hy300-clear-bcb

# Watchdog (dw_wdt com pré-timeout em panic; o kernel o alimenta até alguém abrir /dev/watchdog).
# O watchdogd do AOSP passa a alimentar a cada 10 s com timeout de 30 s: se o userspace parar e
# ele não rodar mais, o pré-timeout dá panic e o aparelho reinicia (panic=5), como no Alpine.
service watchdogd /system/bin/watchdogd 10 20
    class core
    user root
    group root
    oom_score_adjust -1000
    seclabel u:r:watchdogd:s0

# Diagnóstico do primeiro boot sem rede (configs/init/hy300-diag.sh): só no userdebug (pelo
# ro.build.type: o LineageOS sai do userdebug com ro.debuggable=0), e o script
# ainda exige androidboot.hy300.diag=1 na cmdline ou /metadata/hy300-diag/ativo. Começa no
# post-fs (o /metadata já está montado pelo primeiro estágio) e reinicia normal aos 8 min.
# /system/bin/sh: o sh do vendor força PATH=/vendor/bin:/vendor/xbin e não acha logcat, ip nem iw.
service hy300-diag /system/bin/sh /vendor/bin/hy300-diag.sh
    user root
    group root log readproc
    seclabel u:r:su:s0
    disabled
    oneshot

on post-fs && property:ro.build.type=userdebug
    start hy300-diag

# Wi-Fi AIC8800: os módulos sobem em segundo plano (a carga do firmware leva ~40 s) e a interface
# fica para o Android (wificond + wpa_supplicant, sem HAL Wi-Fi do fabricante).
service hy300-wifi-modules /vendor/bin/sh /vendor/bin/hy300-wifi-modules.sh
    user root
    group root
    seclabel u:r:vendor_modprobe:s0
    disabled
    oneshot

on boot
    start hy300-wifi-modules

# Ir ao Alpine e ficar nele pelo adb sem root (configs/init/hy300-alpine.sh): o shell pode setar
# debug.*, e `adb shell setprop debug.hy300.alpine 1` grava a marca de ficar na misc e reinicia.
# Só no userdebug e com o adbd no ar (na imagem de uso, só depois de o usuário ligar o adb).
service hy300-alpine /system/bin/sh /vendor/bin/hy300-alpine.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:debug.hy300.alpine=1 && property:ro.build.type=userdebug && property:init.svc.adbd=running
    start hy300-alpine

# Rede e adb pela rede no userdebug (configs/init/hy300-net.sh): chave do adb e Wi-Fi a partir do
# que o Alpine deixou em /metadata/hy300-diag, depois do boot_completed.
service hy300-net /system/bin/sh /vendor/bin/hy300-net.sh
    user root
    group root
    seclabel u:r:su:s0
    disabled
    oneshot

on property:sys.boot_completed=1 && property:ro.build.type=userdebug
    start hy300-net
