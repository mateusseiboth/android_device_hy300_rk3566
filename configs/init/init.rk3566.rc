# init do HY300 (importado pelo init.rc como /vendor/etc/init/hw/init.${ro.hardware}.rc,
# ro.hardware=rk3566 vem da cmdline). Só o que a placa precisa; o que a fábrica fazia para
# outras placas Rockchip (HDMI, OTG, fb, Mali kbase, PQ) ficou de fora.

on early-init
    # zram com lz4 e swap agressivo, como na fábrica (1,5 GB de RAM)
    write /sys/block/zram0/comp_algorithm lz4
    write /proc/sys/vm/swappiness 100

on fs
    mount_all /vendor/etc/fstab.rk3566 --early

on late-fs
    mount_all /vendor/etc/fstab.rk3566 --late

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

on boot
    # CPU: schedutil (o 4.19 de fábrica usava interactive, que não existe no 6.1)
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil

    # Motor de foco: o app io.github.hy300.settings (uid system) escreve user_cw,
    # user_ccw, aastop etc. e lê o fim de curso. Mesmo caminho da fábrica, que dava 0777.
    chown system system /sys/class/motor_cc/motor_cc/motor
    chmod 0660 /sys/class/motor_cc/motor_cc/motor
    chown system system /sys/class/motor_cc/motor_cc/hd_camera_on
    chmod 0440 /sys/class/motor_cc/motor_cc/hd_camera_on

    # LEDs indicadores, que o app liga e desliga. Ventoinha (Fan_h) e fonte de luz
    # (Lcd_power) ficam só para root: desligar a ventoinha com a luz acesa aquece o projetor.
    chown system system /sys/class/leds/green/brightness
    chmod 0664 /sys/class/leds/green/brightness
    chown system system /sys/class/leds/red/brightness
    chmod 0664 /sys/class/leds/red/brightness

    # Bluetooth AIC8800 (UART1 = ttyS1; a permissão do nó está no ueventd)
    chown bluetooth bluetooth /sys/class/rfkill/rfkill0/state
    chmod 0660 /sys/class/rfkill/rfkill0/state

    # Keystone: o compositor relê os cantos persist.sys.keystone.* no boot, como o
    # init.rk356x.rc de fábrica fazia.
    setprop persist.sys.keystone.update 1

on property:sys.boot_completed=1
    swapon_all /vendor/etc/fstab.rk3566
