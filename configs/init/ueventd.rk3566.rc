# ueventd do HY300 (instalado como /vendor/etc/ueventd.rc). Só os nós que esta placa usa.

# Bluetooth do AIC8800 na UART1
/dev/ttyS1                0660   bluetooth  bluetooth

# Vendor storage da Rockchip (id 50 = modo de instalação, lido pelo U-Boot para girar o logo)
/dev/vendor_storage       0660   system     system

# Decodificador/codificador de vídeo da Rockchip (mpp_service) e RGA: o serviço Codec2
# (android.hardware.media.c2@1.1-service, usuário mediacodec, grupo system) usa os dois.
/dev/mpp_service          0660   system     system
/dev/rga                  0660   system     system

# Entrada HDMI (RK628 -> rkcif/rkisp): para o HAL de TV input/câmera
/dev/video*               0660   system     camera
/dev/v4l-subdev*          0660   system     camera
/dev/media*               0660   system     camera

# Acelerômetro SC7A20 pelo framework "gsensor" da Rockchip: nó de controle (ioctl de liga,
# desliga e taxa) do HAL de sensores (sensors/, usuário system). Os eventos vêm do
# /dev/input/eventN "gsensor" (grupo input).
/dev/mma8452_daemon       0660   system     input
