+// A connector without one of the properties just skips it: only the Rockchip
+// BSP kernel has them.
+bool DrmAtomicStateManager::SetBcshIfNeeded(const AtomicCommitArgs &args,
+                                            AtomicRequest &request) {
+  if (!args.bcsh) {
+    return true;
+  }
+  auto *connector = pipe_->connector->Get();
+  const std::pair<const DrmProperty &, uint64_t> items[] = {
+      {connector->GetBrightnessProperty(), args.bcsh->brightness},
+      {connector->GetContrastProperty(), args.bcsh->contrast},
+      {connector->GetSaturationProperty(), args.bcsh->saturation},
+      {connector->GetHueProperty(), args.bcsh->hue},
+  };
+  for (const auto &[property, value] : items) {
+    if (property && !property.AtomicSet(*request.property_set, value)) {
+      return false;
+    }
+  }
+  return true;
+}
