diff --git a/utils/Bcsh.cpp b/utils/Bcsh.cpp
new file mode 100644
index 0000000..445ab86
--- /dev/null
+++ b/utils/Bcsh.cpp
@@ -0,0 +1,57 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include "Bcsh.h"
+
+#include <algorithm>
+#include <charconv>
+#include <utility>
+
+namespace android::drm_hwcomposer {
+
+namespace {
+
+uint64_t ReadItem(const PropertyGetter &get, std::string_view item) {
+  std::string name = "persist.sys.hy300.picture.";
+  name.append(item);
+  return ParseBcshValue(get(name.c_str()));
+}
+
+}  // namespace
+
+uint64_t ParseBcshValue(std::string_view text) {
+  int64_t value = 0;
+  const char *end = text.data() + text.size();
+  const auto [ptr, error] = std::from_chars(text.data(), end, value);
+  if (text.empty() || error != std::errc() || ptr != end) {
+    return kBcshNeutral;
+  }
+  return static_cast<uint64_t>(
+      std::clamp<int64_t>(value, 0, static_cast<int64_t>(kBcshMax)));
+}
+
+Bcsh ReadBcsh(const PropertyGetter &get) {
+  Bcsh bcsh;
+  bcsh.brightness = ReadItem(get, "brightness");
+  bcsh.contrast = ReadItem(get, "contrast");
+  bcsh.saturation = ReadItem(get, "saturation");
+  bcsh.hue = ReadItem(get, "hue");
+  return bcsh;
+}
+
+BcshSource::BcshSource(PropertyGetter get, PropertySerial serial)
+    : get_(std::move(get)), serial_(std::move(serial)) {
+}
+
+Bcsh BcshSource::Get() {
+  const uint32_t serial = serial_();
+  if (last_serial_ != serial) {
+    last_ = ReadBcsh(get_);
+    last_serial_ = serial;
+  }
+  return last_;
+}
+
+}  // namespace android::drm_hwcomposer
diff --git a/utils/Bcsh.h b/utils/Bcsh.h
new file mode 100644
index 0000000..bdaf81c
--- /dev/null
+++ b/utils/Bcsh.h
@@ -0,0 +1,69 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <cstdint>
+#include <functional>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace android::drm_hwcomposer {
+
+// Brilho, contraste, saturação e matiz (BCSH) feitos pelo hardware de vídeo da Rockchip (bloco
+// BCSH do VOP2, depois da composição). O kernel BSP põe as propriedades "brightness",
+// "contrast", "saturation" e "hue" (0 a 100, neutro em 50) em todo conector. Valem para o
+// display principal e vêm de persist.sys.hy300.picture.<item>, na mesma escala das
+// persist.vendor.<item>.main do HWC da Rockchip. O nome é do sistema porque quem grava é o app de
+// configurações (sistema), e a sepolicy do Treble não deixa o sistema gravar props do vendor.
+constexpr uint64_t kBcshNeutral = 50;
+constexpr uint64_t kBcshMax = 100;
+
+struct Bcsh {
+  uint64_t brightness = kBcshNeutral;
+  uint64_t contrast = kBcshNeutral;
+  uint64_t saturation = kBcshNeutral;
+  uint64_t hue = kBcshNeutral;
+
+  bool operator==(const Bcsh &other) const {
+    return brightness == other.brightness && contrast == other.contrast &&
+           saturation == other.saturation && hue == other.hue;
+  }
+  bool operator!=(const Bcsh &other) const {
+    return !(*this == other);
+  }
+  bool IsNeutral() const {
+    return *this == Bcsh{};
+  }
+};
+
+using PropertyGetter = std::function<std::string(const char *name)>;
+using PropertySerial = std::function<uint32_t()>;
+
+// "0" a "100"; vazio ou inválido é o neutro, fora da faixa vai para o limite.
+uint64_t ParseBcshValue(std::string_view text);
+
+Bcsh ReadBcsh(const PropertyGetter &get);
+
+// Relê as props só quando alguma propriedade do sistema mudou (serial global da área de
+// propriedades), para custar quase nada a cada quadro.
+class BcshSource {
+ public:
+  BcshSource(PropertyGetter get, PropertySerial serial);
+
+  // Props reais do Android (property_get e __system_property_area_serial).
+  static BcshSource FromSystemProperties();
+
+  Bcsh Get();
+
+ private:
+  PropertyGetter get_;
+  PropertySerial serial_;
+  std::optional<uint32_t> last_serial_;
+  Bcsh last_{};
+};
+
+}  // namespace android::drm_hwcomposer
diff --git a/utils/BcshProperties.cpp b/utils/BcshProperties.cpp
new file mode 100644
index 0000000..50ee7f8
--- /dev/null
+++ b/utils/BcshProperties.cpp
@@ -0,0 +1,22 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <cutils/properties.h>
+#include <sys/system_properties.h>
+
+#include "Bcsh.h"
+
+namespace android::drm_hwcomposer {
+
+BcshSource BcshSource::FromSystemProperties() {
+  return {[](const char *name) {
+            char value[PROPERTY_VALUE_MAX] = {};
+            property_get(name, value, "");
+            return std::string(value);
+          },
+          [] { return __system_property_area_serial(); }};
+}
+
+}  // namespace android::drm_hwcomposer
diff --git a/utils/BcshTest.cpp b/utils/BcshTest.cpp
new file mode 100644
index 0000000..e6a740a
--- /dev/null
+++ b/utils/BcshTest.cpp
@@ -0,0 +1,87 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#include <gtest/gtest.h>
+
+#include <map>
+#include <string>
+
+#include "Bcsh.h"
+
+namespace android::drm_hwcomposer {
+namespace {
+
+class FakeProperties {
+ public:
+  std::string Get(const char *name) const {
+    ++reads;
+    const auto it = values.find(name);
+    return it == values.end() ? std::string() : it->second;
+  }
+
+  std::map<std::string, std::string> values;
+  uint32_t serial = 1;
+  mutable int reads = 0;
+};
+
+TEST(BcshParseValueTest, ReadsTheZeroToHundredScale) {
+  EXPECT_EQ(ParseBcshValue("0"), 0U);
+  EXPECT_EQ(ParseBcshValue("55"), 55U);
+  EXPECT_EQ(ParseBcshValue("100"), 100U);
+}
+
+TEST(BcshParseValueTest, EmptyOrInvalidIsNeutral) {
+  EXPECT_EQ(ParseBcshValue(""), kBcshNeutral);
+  EXPECT_EQ(ParseBcshValue("abc"), kBcshNeutral);
+  EXPECT_EQ(ParseBcshValue("5x"), kBcshNeutral);
+}
+
+TEST(BcshParseValueTest, OutOfRangeIsClamped) {
+  EXPECT_EQ(ParseBcshValue("-3"), 0U);
+  EXPECT_EQ(ParseBcshValue("250"), kBcshMax);
+}
+
+TEST(BcshReadTest, ReadsThePictureProps) {
+  FakeProperties props;
+  props.values = {{"persist.sys.hy300.picture.brightness", "60"},
+                  {"persist.sys.hy300.picture.contrast", "45"},
+                  {"persist.sys.hy300.picture.saturation", "70"},
+                  {"persist.sys.hy300.picture.hue", "52"}};
+  const Bcsh bcsh = ReadBcsh([&](const char *n) { return props.Get(n); });
+  EXPECT_EQ(bcsh, (Bcsh{60, 45, 70, 52}));
+}
+
+// As props do HWC da Rockchip não valem aqui: o app do sistema não pode gravá-las.
+TEST(BcshReadTest, IgnoresTheRockchipVendorProps) {
+  FakeProperties props;
+  props.values = {{"persist.vendor.brightness.main", "90"}};
+  EXPECT_TRUE(ReadBcsh([&](const char *n) { return props.Get(n); }).IsNeutral());
+}
+
+TEST(BcshReadTest, MissingPropsAreNeutral) {
+  FakeProperties props;
+  const Bcsh bcsh = ReadBcsh([&](const char *n) { return props.Get(n); });
+  EXPECT_EQ(bcsh, Bcsh{});
+  EXPECT_TRUE(bcsh.IsNeutral());
+}
+
+TEST(BcshSourceTest, RereadsOnlyWhenAPropertyChanged) {
+  FakeProperties props;
+  props.values["persist.sys.hy300.picture.contrast"] = "40";
+  BcshSource source([&](const char *n) { return props.Get(n); },
+                    [&] { return props.serial; });
+
+  EXPECT_EQ(source.Get().contrast, 40U);
+  const int reads = props.reads;
+  EXPECT_EQ(source.Get().contrast, 40U);
+  EXPECT_EQ(props.reads, reads);
+
+  props.values["persist.sys.hy300.picture.contrast"] = "65";
+  props.serial++;
+  EXPECT_EQ(source.Get().contrast, 65U);
+}
+
+}  // namespace
+}  // namespace android::drm_hwcomposer
