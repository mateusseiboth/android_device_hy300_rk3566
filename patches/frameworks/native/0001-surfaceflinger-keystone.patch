diff --git a/services/surfaceflinger/Keystone/KeystoneController.cpp b/services/surfaceflinger/Keystone/KeystoneController.cpp
new file mode 100644
index 0000000..bb97ac8
--- /dev/null
+++ b/services/surfaceflinger/Keystone/KeystoneController.cpp
@@ -0,0 +1,152 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#undef LOG_TAG
+#define LOG_TAG "SurfaceFlinger-Keystone"
+
+#include "KeystoneController.h"
+
+#include <android-base/properties.h>
+#include <android-base/stringprintf.h>
+#include <log/log.h>
+#include <pthread.h>
+#include <sys/system_properties.h>
+
+#include <cinttypes>
+#include <ctime>
+
+namespace android::surfaceflinger::keystone {
+namespace {
+
+constexpr const char* kUpdateProp = "persist.sys.keystone.update";
+constexpr const char* kResetProp = "persist.sys.keystone.reset";
+constexpr const char* kDisableProp = "persist.sys.keystone.disable";
+constexpr const char* kMirrorXProp = "persist.sys.keystone.mirror_x";
+constexpr const char* kMirrorYProp = "persist.sys.keystone.mirror_y";
+constexpr const char* kCornerProps[] = {
+        "persist.sys.keystone.lt",
+        "persist.sys.keystone.lb",
+        "persist.sys.keystone.rt",
+        "persist.sys.keystone.rb",
+};
+constexpr const char* kZeroCorner = "0,0";
+
+// Só para a thread conferir o pedido de parada de tempos em tempos.
+constexpr timespec kWaitTimeout = {.tv_sec = 5, .tv_nsec = 0};
+
+Point readCorner(const char* prop) {
+    const std::string text = base::GetProperty(prop, kZeroCorner);
+    if (const auto corner = parseCorner(text)) {
+        return *corner;
+    }
+    ALOGW("%s=\"%s\" não é \"x,y\"; usando 0,0", prop, text.c_str());
+    return {};
+}
+
+Config readConfig() {
+    Config config;
+    config.corners = {readCorner(kCornerProps[0]), readCorner(kCornerProps[1]),
+                      readCorner(kCornerProps[2]), readCorner(kCornerProps[3])};
+    config.mirrorX = parseFlag(base::GetProperty(kMirrorXProp, ""));
+    config.mirrorY = parseFlag(base::GetProperty(kMirrorYProp, ""));
+    config.disabled = parseFlag(base::GetProperty(kDisableProp, ""));
+    return config;
+}
+
+// persist.sys.keystone.reset=1 zera os 4 cantos, como a librkgfx_dc da fábrica.
+void applyResetRequest(Config& config) {
+    if (!parseFlag(base::GetProperty(kResetProp, ""))) {
+        return;
+    }
+    config.corners = {};
+    for (const char* prop : kCornerProps) {
+        base::SetProperty(prop, kZeroCorner);
+    }
+    base::SetProperty(kResetProp, "0");
+}
+
+std::string formatConfig(const Config& config) {
+    const auto& c = config.corners;
+    return base::StringPrintf("lt=%g,%g lb=%g,%g rt=%g,%g rb=%g,%g mirror_x=%d mirror_y=%d "
+                              "disable=%d",
+                              c.leftTop.x, c.leftTop.y, c.leftBottom.x, c.leftBottom.y,
+                              c.rightTop.x, c.rightTop.y, c.rightBottom.x, c.rightBottom.y,
+                              config.mirrorX, config.mirrorY, config.disabled);
+}
+
+} // namespace
+
+KeystoneController::KeystoneController(OnChange onChange) : mOnChange(std::move(onChange)) {
+    reload();
+    mThread = std::thread(&KeystoneController::run, this);
+}
+
+KeystoneController::~KeystoneController() {
+    mStop = true;
+    mThread.join();
+}
+
+std::optional<mat4> KeystoneController::getTransform(int32_t width, int32_t height) {
+    std::lock_guard lock(mMutex);
+    if (mCache && mCache->generation == mGeneration && mCache->width == width &&
+        mCache->height == height) {
+        return mCache->transform;
+    }
+    std::optional<mat4> transform;
+    if (const auto matrix = buildKeystoneMatrix(mConfig, static_cast<float>(width),
+                                                static_cast<float>(height))) {
+        const std::array<float, 16> columns = toColumnMajor4x4(*matrix);
+        transform = mat4(static_cast<const float*>(columns.data()));
+    }
+    mCache = Cache{mGeneration, width, height, transform};
+    return transform;
+}
+
+void KeystoneController::dump(std::string& out) const {
+    std::lock_guard lock(mMutex);
+    base::StringAppendF(&out, "Keystone: %s (geração %" PRIu64 ", %s)\n",
+                        formatConfig(mConfig).c_str(), mGeneration,
+                        mCache && mCache->transform ? "ativo" : "inativo");
+}
+
+void KeystoneController::reload() {
+    Config config = readConfig();
+    applyResetRequest(config);
+    ALOGI("cantos relidos: %s", formatConfig(config).c_str());
+    std::lock_guard lock(mMutex);
+    mConfig = config;
+    ++mGeneration;
+}
+
+void KeystoneController::run() {
+    pthread_setname_np(pthread_self(), "keystone");
+    uint32_t globalSerial = 0;
+    std::optional<uint32_t> handledSerial;
+    while (!mStop) {
+        waitForTrigger(globalSerial, handledSerial);
+    }
+}
+
+// O serial é lido antes do valor: um "1" gravado depois da leitura muda o serial e a espera
+// volta na hora. Cada serial é tratado uma vez só: se o "0" não puder ser gravado, a thread
+// dorme até a próxima gravação do app, sem reler nem pedir quadro a cada volta da espera.
+void KeystoneController::waitForTrigger(uint32_t& globalSerial,
+                                        std::optional<uint32_t>& handledSerial) {
+    const prop_info* info = __system_property_find(kUpdateProp);
+    if (info == nullptr) {
+        __system_property_wait(nullptr, globalSerial, &globalSerial, &kWaitTimeout);
+        return;
+    }
+    uint32_t serial = __system_property_serial(info);
+    if (serial != handledSerial && parseFlag(base::GetProperty(kUpdateProp, ""))) {
+        reload();
+        base::SetProperty(kUpdateProp, "0");
+        mOnChange();
+    }
+    handledSerial = serial;
+    __system_property_wait(info, serial, &serial, &kWaitTimeout);
+}
+
+} // namespace android::surfaceflinger::keystone
