+void SurfaceFlinger::applyKeystone(PhysicalDisplayId displayId,
+                                   compositionengine::CompositionRefreshArgs& refreshArgs) {
+    if (!mKeystone) {
+        return;
+    }
+    const auto display = FTL_FAKE_GUARD(mStateLock, getDisplayDeviceLocked(displayId));
+    if (!display) {
+        return;
+    }
+    const Rect bounds =
+            display->getCompositionDisplay()->getState().framebufferSpace.getBoundsAsRect();
+    if (const auto transform = mKeystone->getTransform(bounds.getWidth(), bounds.getHeight())) {
+        refreshArgs.keystone = {display->getId(), *transform};
+    }
+}
