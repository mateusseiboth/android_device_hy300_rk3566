+// Teto traseiro do app (espelho vertical): lt 0,-720 lb 0,720 rt 0,-720 rb 0,720.
+TEST(KeystoneBuildMatrixTest, ceilingRearModeMirrorsVertically) {
+    Config config;
+    config.corners = {{0.f, -720.f}, {0.f, 720.f}, {0.f, -720.f}, {0.f, 720.f}};
+    const auto matrix = buildKeystoneMatrix(config, kWidth, kHeight);
+    ASSERT_TRUE(matrix.has_value());
+
+    expectPointNear({100.f, kHeight - 50.f}, mapPoint(*matrix, {100.f, 50.f}));
+}
+
+// Mesa traseira com ajuste do usuário: o app grava lt = 1260,-20 (base 1280,0 e o ajuste de
+// 20 px para dentro com o sinal do eixo espelhado). O canto de cima à esquerda da imagem cai
+// perto do canto de cima à direita do painel, 20 px (escalados) para dentro.
+TEST(KeystoneBuildMatrixTest, rearTableModeKeepsTheUserKeystone) {
+    Config config;
+    config.corners = {{1260.f, -20.f}, {1280.f, 0.f}, {-1280.f, 0.f}, {-1280.f, 0.f}};
+    const auto matrix = buildKeystoneMatrix(config, kWidth, kHeight);
+    ASSERT_TRUE(matrix.has_value());
+
+    const float dx = 20.f * kWidth / kLogicalWidth;
+    const float dy = 20.f * kHeight / kLogicalHeight;
+    expectPointNear({kWidth - dx, dy}, mapPoint(*matrix, {0.f, 0.f}));
+    expectPointNear({0.f, kHeight}, mapPoint(*matrix, {kWidth, kHeight}));
+}
+
+// Espelho nativo (persist.sys.keystone.mirror_x) junto com a homografia: a imagem é espelhada
+// antes e o resultado vai para o quadrilátero dos cantos.
+TEST(KeystoneBuildMatrixTest, mirrorFlagCombinesWithTheCorners) {
+    Config config;
+    config.corners.leftTop = {20.f, -20.f};
+    config.corners.rightTop = {-20.f, -20.f};
+    config.mirrorX = true;
+    const auto matrix = buildKeystoneMatrix(config, kWidth, kHeight);
+    ASSERT_TRUE(matrix.has_value());
+
+    const float dx = 20.f * kWidth / kLogicalWidth;
+    const float dy = 20.f * kHeight / kLogicalHeight;
+    // O canto de cima à esquerda da imagem vai para o canto de cima à direita do quadrilátero.
+    expectPointNear({kWidth - dx, dy}, mapPoint(*matrix, {0.f, 0.f}));
+    expectPointNear({dx, dy}, mapPoint(*matrix, {kWidth, 0.f}));
+    expectPointNear({kWidth, kHeight}, mapPoint(*matrix, {0.f, kHeight}));
+}
+
+TEST(KeystoneBuildMatrixTest, bothMirrorFlagsTurnTheImage) {
+    Config config;
+    config.mirrorX = true;
+    config.mirrorY = true;
+    const auto matrix = buildKeystoneMatrix(config, kWidth, kHeight);
+    ASSERT_TRUE(matrix.has_value());
+
+    expectPointNear({kWidth - 100.f, kHeight - 50.f}, mapPoint(*matrix, {100.f, 50.f}));
+}
