HY300: HALs de exemplo do AOSP declarando as "interface" no init e áudio sem Bluetooth.
- .rc de áudio (core e efeitos), gatekeeper, health, keymint e power com "interface aidl ...":
  o servicemanager sobe o serviço sob demanda (no boot 3 o init não achava o IModule/default);
- o APEX de áudio não declara o módulo bluetooth nem o provedor de áudio Bluetooth: o HY300
  não tem Bluetooth e ninguém registraria essas instâncias.

diff --git a/audio/aidl/default/android.hardware.audio.service-aidl.example.rc b/audio/aidl/default/android.hardware.audio.service-aidl.example.rc
index c3e19ba..d593dea 100644
--- a/audio/aidl/default/android.hardware.audio.service-aidl.example.rc
+++ b/audio/aidl/default/android.hardware.audio.service-aidl.example.rc
@@ -1,5 +1,8 @@
 
 service vendor.audio-hal-aidl /apex/com.android.hardware.audio/bin/hw/android.hardware.audio.service-aidl.example
+    interface aidl android.hardware.audio.core.IConfig/default
+    interface aidl android.hardware.audio.core.IModule/default
+    interface aidl android.hardware.audio.core.IModule/r_submix
     class hal
     user audioserver
     # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
@@ -12,6 +15,7 @@ service vendor.audio-hal-aidl /apex/com.android.hardware.audio/bin/hw/android.ha
     onrestart restart audioserver
 
 service vendor.audio-effect-hal-aidl /apex/com.android.hardware.audio/bin/hw/android.hardware.audio.effect.service-aidl.example
+    interface aidl android.hardware.audio.effect.IFactory/default
     class hal
     user audioserver
     # media gid needed for /dev/fm (radio) and for /data/misc/media (tee)
