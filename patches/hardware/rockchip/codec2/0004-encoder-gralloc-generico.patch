HY300: encoders do Codec2 da Rockchip com gralloc genérico (minigbm).
O caminho de entrada do C2RKMpiEnc pedia RK_GRALLOC_USAGE_WITHIN_4G e STRIDE_ALIGN_16 (o minigbm
recusa bit desconhecido: "Unhandled gralloc usage" e BO_USE_NONE) e alocava o buffer temporário
da RGA com o NV12 da Rockchip (0x15). Com C2_RK_GENERIC_GRALLOC (cflag do patch 0002):
 - o uso de entrada não leva bits privados (toda a RAM do HY300 fica abaixo de 4 GiB);
 - o buffer temporário é YCBCR_420_888 (NV12 no minigbm) com uso de encoder;
 - stride de entrada desalinhado passa pela RGA, que copia para o buffer alinhado.

diff --git a/component/video/C2RKMpiEnc.cpp b/component/video/C2RKMpiEnc.cpp
index 23299e2..f1d723d 100644
--- a/component/video/C2RKMpiEnc.cpp
+++ b/component/video/C2RKMpiEnc.cpp
@@ -46,6 +46,20 @@ namespace android {
 
 C2_LOGGER_ENABLE("C2RKMpiEnc");
 
+#ifdef C2_RK_GENERIC_GRALLOC
+/*
+ * Gralloc genérico (minigbm): recusa bit de uso que não conhece (RK_GRALLOC_USAGE_WITHIN_4G,
+ * RK_GRALLOC_USAGE_STRIDE_ALIGN_16) e não conhece o NV12 da Rockchip (0x15).
+ *  - WITHIN_4G sai: no RK3566 do HY300 toda a RAM fica abaixo de 4 GiB.
+ *  - STRIDE_ALIGN_16 sai: quando o stride da entrada não é múltiplo de 16, a RGA copia o quadro
+ *    para o buffer temporário (alinhado), em vez de o gralloc alinhar na alocação.
+ *  - O buffer temporário usa YCBCR_420_888, que o minigbm resolve para NV12.
+ */
+constexpr bool kGenericGralloc = true;
+#else
+constexpr bool kGenericGralloc = false;
+#endif
+
 void ParseGop(
         const C2StreamGopTuning::output &gop,
         uint32_t *syncInterval, uint32_t *iInterval, uint32_t *maxBframes) {
@@ -133,6 +147,10 @@ public:
         auto getRgaCompatibilityUsage = []() -> int64_t {
             int64_t usage = 0;
 
+            if (kGenericGralloc) {
+                return usage;
+            }
+
             if (C2RKChipCapDef::get()->hasRga2()) {
                 usage |= RK_GRALLOC_USAGE_WITHIN_4G;
             }
@@ -2569,13 +2587,19 @@ c2_status_t C2RKMpiEnc::initEncoder() {
     buffer_handle_t bufferHandle;
 
     // allocate buffer within 4G to avoid rga2 error.
-    if (C2RKChipCapDef::get()->hasRga2()) {
+    if (!kGenericGralloc && C2RKChipCapDef::get()->hasRga2()) {
         usage = RK_GRALLOC_USAGE_WITHIN_4G;
     }
 
+    int32_t dmaFormat = 0x15 /* NV12 */;
+    if (kGenericGralloc) {
+        usage |= GRALLOC_USAGE_HW_VIDEO_ENCODER;
+        dmaFormat = HAL_PIXEL_FORMAT_YCBCR_420_888;
+    }
+
     status_t status = GraphicBufferAllocator::get().allocate(
             C2_ALIGN(mSize->width, 16), C2_ALIGN(mSize->height, 16),
-            0x15 /* NV12 */, 1u /* layer count */,
+            dmaFormat, 1u /* layer count */,
             usage, &bufferHandle, &stride, "C2RKMpiEnc");
     CHECK(status == OK) << "Failed to allocate DMA memory";
 
@@ -3210,6 +3234,12 @@ bool C2RKMpiEnc::needRgaConvert(uint32_t width, uint32_t height, MppFrameFormat
         if (needsRga && C2_IS_ALIGNED(width, 16) && C2_IS_ALIGNED(height, 16)) {
             needsRga = false;
         }
+
+        // Sem RK_GRALLOC_USAGE_STRIDE_ALIGN_16 o stride pode chegar desalinhado.
