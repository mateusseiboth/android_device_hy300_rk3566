new file mode 100644
index 0000000..253451d
--- /dev/null
+++ b/component/osal/include/C2RKGenericGralloc.h
@@ -0,0 +1,36 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <cstdint>
+
+// HY300: vídeo 10 bits (HEVC Main10, VP9 perfil 2, H.264 High10) com o gralloc genérico
+// (minigbm). O decodificador fica em "buffer mode": o MPP decodifica em 10 bits compacto (NV15)
+// nos buffers dele e a RGA (ou a CPU) converte para NV12 de 8 bits no bloco do minigbm, que é o
+// que a GPU (Panfrost) e o painel de 8 bits usam. Sem dependência do Android, para os testes.
+namespace android::c2_rk_generic {
+
+// system/core/libsystem/include/system/graphics-base-v1.*.h
+constexpr uint32_t kHalYcbcr420888 = 0x23;  // HAL_PIXEL_FORMAT_YCBCR_420_888
+constexpr uint32_t kHalYcbcrP010 = 0x36;    // HAL_PIXEL_FORMAT_YCBCR_P010
+
+// mpp_frame_get_hor_stride() do 10 bits compacto está em bytes (4 pixels em 5 bytes); a
+// wstride da RGA (RK_FORMAT_YCbCr_420_SP_10B) está em pixels.
+constexpr int32_t toRgaWidthStride(bool is10bit, int32_t horStrideBytes) {
+    return is10bit ? horStrideBytes * 8 / 10 : horStrideBytes;
+}
+
+// O minigbm genérico não tem DRM_FORMAT_P010 (dumb_driver.c), então P010 só vale com o gralloc
+// da Rockchip.
+constexpr bool isP010Usable(bool genericGralloc, bool allowedByApiLevel) {
+    return !genericGralloc && allowedByApiLevel;
+}
+
+constexpr uint32_t selectOutputPixelFormat(bool genericGralloc, uint32_t requested) {
+    return genericGralloc && requested == kHalYcbcrP010 ? kHalYcbcr420888 : requested;
+}
+
+}  // namespace android::c2_rk_generic
diff --git a/component/osal/tests/C2RKGenericGrallocTest.cpp b/component/osal/tests/C2RKGenericGrallocTest.cpp
new file mode 100644
index 0000000..e381e75
--- /dev/null
+++ b/component/osal/tests/C2RKGenericGrallocTest.cpp
@@ -0,0 +1,44 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * HY300: regras do vídeo 10 bits com o gralloc genérico (minigbm). Rodam no host.
+ */
+
+#include <gtest/gtest.h>
+
+#include "C2RKGenericGralloc.h"
+
+namespace android::c2_rk_generic {
+namespace {
+
+// O MPP dá o stride horizontal do 10 bits compacto (NV15) em bytes; a RGA quer pixels.
+TEST(GenericGrallocStrideTest, tenBitStrideGoesFromBytesToPixels) {
+    EXPECT_EQ(toRgaWidthStride(true, 2400), 1920);
+    EXPECT_EQ(toRgaWidthStride(true, 2560), 2048);
+}
+
+TEST(GenericGrallocStrideTest, eightBitStrideIsAlreadyInPixels) {
+    EXPECT_EQ(toRgaWidthStride(false, 1920), 1920);
+}
+
+// O minigbm genérico não aloca P010 e nem a GPU (Panfrost) nem o VOP2 o leem no nosso
+// caminho: o decodificador não pode anunciar P010, mesmo que o nível de API permita.
+TEST(GenericGrallocP010Test, genericGrallocNeverOffersP010) {
+    EXPECT_FALSE(isP010Usable(true, true));
+    EXPECT_FALSE(isP010Usable(true, false));
+}
+
+TEST(GenericGrallocP010Test, rockchipGrallocFollowsTheApiLevel) {
+    EXPECT_TRUE(isP010Usable(false, true));
+    EXPECT_FALSE(isP010Usable(false, false));
+}
+
+TEST(GenericGrallocFormatTest, p010RequestFallsBackToEightBitNv12) {
+    EXPECT_EQ(selectOutputPixelFormat(true, kHalYcbcrP010), kHalYcbcr420888);
+    EXPECT_EQ(selectOutputPixelFormat(true, kHalYcbcr420888), kHalYcbcr420888);
+    EXPECT_EQ(selectOutputPixelFormat(false, kHalYcbcrP010), kHalYcbcrP010);
+}
+
+}  // namespace
+}  // namespace android::c2_rk_generic
