new file mode 100644
index 0000000..9d4c0db
--- /dev/null
+++ b/component/osal/include/C2RKGenericInput.h
@@ -0,0 +1,51 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+#pragma once
+
+#include <cstdint>
+
+// HY300: entrada do encoder com o gralloc genérico (minigbm). O buffer da Surface de entrada
+// (display virtual da gravação de tela ou do scrcpy) é alocado para a GPU e o encoder, sem uso
+// de CPU, e o minigbm recusa o lock pela CPU. O MPP e a RGA leem o dma-buf pelo fd, então o
+// encoder não precisa mapear: o layout vem do formato HAL do handle. Sem dependência do Android,
+// para os testes.
+namespace android::c2_rk_generic {
+
+enum class InputLayout { kRgba, kYuv, kUnknown };
+
+// system/core/libsystem/include/system/graphics-base-v1.0.h e o NV12 da Rockchip.
+constexpr uint32_t kHalInRgba8888 = 0x1;
+constexpr uint32_t kHalInRgbx8888 = 0x2;
+constexpr uint32_t kHalInBgra8888 = 0x5;
+constexpr uint32_t kHalInYcrcb420Sp = 0x11;
+constexpr uint32_t kHalInRkNv12 = 0x15;
+constexpr uint32_t kHalInImplementationDefined = 0x22;
+constexpr uint32_t kHalInYcbcr420888 = 0x23;
+
+constexpr InputLayout inputLayoutFromHalFormat(uint32_t format) {
+    switch (format) {
+        case kHalInRgba8888:
+        case kHalInRgbx8888:
+        case kHalInBgra8888:
+        // O minigbm resolve IMPLEMENTATION_DEFINED sem uso de câmera para XBGR8888 (RGBA).
+        case kHalInImplementationDefined:
+            return InputLayout::kRgba;
+        case kHalInYcrcb420Sp:
+        case kHalInRkNv12:
+        // O minigbm resolve YCBCR_420_888 para NV12.
+        case kHalInYcbcr420888:
+            return InputLayout::kYuv;
+        default:
+            return InputLayout::kUnknown;
+    }
+}
+
+// Com o gralloc da Rockchip o lock funciona e o caminho original fica igual.
+constexpr bool needsCpuMapping(bool genericGralloc) {
+    return !genericGralloc;
+}
+
+}  // namespace android::c2_rk_generic
diff --git a/component/osal/tests/C2RKGenericInputTest.cpp b/component/osal/tests/C2RKGenericInputTest.cpp
new file mode 100644
index 0000000..d19fdc9
--- /dev/null
+++ b/component/osal/tests/C2RKGenericInputTest.cpp
@@ -0,0 +1,45 @@
+/*
+ * SPDX-FileCopyrightText: 2026 Mateus Seiboth
+ * SPDX-License-Identifier: Apache-2.0
+ *
+ * HY300: entrada do encoder com o gralloc genérico (minigbm). Rodam no host.
+ */
+
+#include <gtest/gtest.h>
+
+#include "C2RKGenericInput.h"
+
+namespace android::c2_rk_generic {
+namespace {
+
+// Boot 8: o RGBA da Surface de entrada (display virtual) vem sem uso de CPU e o lock falhava
+// ("failed to mapInputBuffer with err 14"). Com o gralloc genérico não há lock nenhum.
+TEST(GenericInputTest, genericGrallocNeverLocksTheInput) {
+    EXPECT_FALSE(needsCpuMapping(true));
+}
+
+TEST(GenericInputTest, rockchipGrallocKeepsTheOriginalMapping) {
+    EXPECT_TRUE(needsCpuMapping(false));
+}
+
+// O layout que o lock dava vem do formato HAL do handle.
+TEST(GenericInputTest, rgbaSurfaceInputIsRgba) {
+    EXPECT_EQ(inputLayoutFromHalFormat(0x1), InputLayout::kRgba);  // RGBA_8888 do boot 8
+    EXPECT_EQ(inputLayoutFromHalFormat(0x2), InputLayout::kRgba);
+    EXPECT_EQ(inputLayoutFromHalFormat(0x5), InputLayout::kRgba);
+    EXPECT_EQ(inputLayoutFromHalFormat(0x22), InputLayout::kRgba);  // IMPLEMENTATION_DEFINED
+}
+
+TEST(GenericInputTest, byteBufferInputIsYuv) {
+    EXPECT_EQ(inputLayoutFromHalFormat(0x23), InputLayout::kYuv);  // YCBCR_420_888
+    EXPECT_EQ(inputLayoutFromHalFormat(0x15), InputLayout::kYuv);
+    EXPECT_EQ(inputLayoutFromHalFormat(0x11), InputLayout::kYuv);
+}
+
+TEST(GenericInputTest, otherFormatsAreRefused) {
+    EXPECT_EQ(inputLayoutFromHalFormat(0x36), InputLayout::kUnknown);  // P010
+    EXPECT_EQ(inputLayoutFromHalFormat(0), InputLayout::kUnknown);
+}
+
+}  // namespace
+}  // namespace android::c2_rk_generic
