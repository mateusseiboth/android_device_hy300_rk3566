/dev/mma8452_daemon             u:object_r:hy300_gsensor_device:s0
/dev/vendor_storage             u:object_r:hy300_vendor_storage_device:s0
/dev/ttyS1                      u:object_r:hci_attach_dev:s0

# Partições do eMMC (GPT de fábrica)
/dev/block/by-name/misc         u:object_r:misc_block_device:s0
/dev/block/by-name/metadata     u:object_r:metadata_block_device:s0
