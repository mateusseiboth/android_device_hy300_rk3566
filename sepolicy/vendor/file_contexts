/vendor/bin/hy300-clear-bcb\.sh u:object_r:hy300_clear_bcb_exec:s0

# Bibliotecas que o EGL/Vulkan (Mesa Panfrost) e o mapper do minigbm puxam para dentro dos
# processos do sistema (same-process HAL): SurfaceFlinger, system_server, apps.
/vendor/lib(64)?/egl/lib(EGL|GLESv1_CM|GLESv2)_mesa\.so                 u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libgallium_dri\.so                                     u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/vulkan\.pastel\.so                                  u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/hw/mapper\.minigbm\.so                                 u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libminigbm_gralloc\.so                                 u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libdrm\.so                                             u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libdmabufheap\.so                                      u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libgralloctypes\.so                                    u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/libaconfig_storage_read_api_cc\.so                     u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/lib(base|c\+\+|cutils|utils|hidlbase|hardware|ui|z)\.so u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.common-V2-ndk\.so                   u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.graphics\.allocator-V2-ndk\.so      u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.graphics\.allocator@[234]\.0\.so    u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.graphics\.common-V7-ndk\.so         u:object_r:same_process_hal_file:s0
/vendor/lib(64)?/android\.hardware\.graphics\.common@1\.[012]\.so       u:object_r:same_process_hal_file:s0
/vendor/bin/hy300-wifi-modules\.sh u:object_r:hy300_wifi_modules_exec:s0
/vendor/bin/hw/vendor\.hy300\.hdmiin-service u:object_r:hy300_hdmiin_exec:s0

# Módulos do kernel no /vendor (BOARD_VENDOR_KERNEL_MODULES): o AOSP não rotula este diretório e
# o insmod do hy300-wifi-modules e o modprobe da GPU precisam de module_load no tipo próprio.
/vendor/lib/modules(/.*)?  u:object_r:vendor_kernel_modules:s0
