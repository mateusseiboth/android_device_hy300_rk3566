# HAL do Widevine (binário do Google, vendor/hy300-widevine; só no build local). Mesmo domínio do
# emulador (device/generic/goldfish/sepolicy/vendor/hal_drm_widevine.te), sem o composer: aqui o
# L3 decifra para buffers comuns, que vêm do Codec2 da Rockchip (mediacodec) e do app.
type hal_drm_widevine, domain;
hal_server_domain(hal_drm_widevine, hal_drm)

type hal_drm_widevine_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(hal_drm_widevine)

allow hal_drm_widevine mediacodec:fd use;
allow hal_drm_widevine hal_codec2_server:fd use;

# Certificado do aparelho e licenças offline em /data/vendor/mediadrm.
allow hal_drm_widevine mediadrm_vendor_data_file:dir create_dir_perms;
allow hal_drm_widevine mediadrm_vendor_data_file:file create_file_perms;
