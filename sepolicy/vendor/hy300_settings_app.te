# App de configurações do projetor (domínio do system_ext): motor de foco e LEDs indicadores,
# com tipos próprios (o Treble proíbe ao sistema o sysfs_leds e o sysfs sem rótulo).
allow hy300_settings_app sysfs_hy300_motor:file rw_file_perms;
allow hy300_settings_app sysfs_hy300_leds:file rw_file_perms;
